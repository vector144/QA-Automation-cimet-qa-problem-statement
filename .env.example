# Get a free API key at: https://openrouter.ai/keys (no credit card required)
OPENROUTER_API_KEY=sk-or-your-free-key-here
DATABASE_PATH=./cimet.db

# OpenRouter Free Models:
# - meta-llama/llama-3.3-70b-instruct:free (Recommended, highly capable)
# - google/gemini-2.0-flash-exp:free
# - mistralai/mistral-7b-instruct:free
# - openrouter/free (Auto-selects best available free model)
DEFAULT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
ENVIRONMENT=development

# Groq API — free Whisper transcription: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
